DISCORD_TOKEN=            # token of the surviving "PKMD Reposter" application
GUILD_ID=                 # your PKMD server id
DB_PATH=/data/reposter.db # attach a Railway volume at /data
AMAZON_TAG=stocktcg-20
DRY_RUN=1                 # start in dry-run; flip to 0 after parallel verification
DEDUPE_MINUTES=30
WALMART_BATCH_SIZE=5
WALMART_BATCH_SECONDS=20
