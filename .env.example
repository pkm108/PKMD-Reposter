# Copy this file to .env and fill in the real values.

# Bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# Channel the bot LISTENS to (where the Pokemon Deals bot posts its pings)
SOURCE_CHANNEL_ID=

# Where regular TCG pings (and anything that isn't a Pokemon x Target collab) go
TCG_CHANNEL_ID=

# Where Pokemon x Target collab pings go
COLLAB_CHANNEL_ID=

# "true" -> forward using a webhook so the original bot's name + avatar are preserved
# "false" -> forward as your own bot
USE_WEBHOOKS=true
